# .gitignore for Visual Studio Projects
# Build results
[Bb]in/
[Oo]bj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# Windows image file caches
Thumbs.db
*.DS_Store

# Visual Studio Code
.vscode/

# Dotnet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Npm Packages
node_modules/

# Logs
*.log
logs/

# Others
*.vspscc
*.vssscc
*.dbmdl
*.bak
*.backup
*.swp
*.tmp
*.tmp/*
*.pid
*.seed
*.orig
*.rej
*.sdf
*.cache
*.pdb
*.mdb
*.opendb
*.VC.db
*.vscode/
